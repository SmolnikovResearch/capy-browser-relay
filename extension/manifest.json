{
  "manifest_version": 3,
  "name": "CapyAgent Browser",
  "short_name": "CapyAgent Browser",
  "version": "1.4.0",
  "description": "Lets approved AI agents (Claude, Codex, Hermes, OpenClaw) use this browser via your relay with full user confirmation.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "tabs", "tabGroups", "scripting", "alarms", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "optional_host_permissions": ["<all_urls>"],
  "side_panel": { "default_path": "panel.html" },
  "action": {
    "default_title": "CapyAgent",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
